# HIVE Environment Configuration

# Database: SQLite by default for instant zero-dependency execution.
# To switch to PostgreSQL, set:
# DATABASE_URL="postgresql://user:password@localhost:5432/hivedb?schema=public"
# And in prisma/schema.prisma change provider = "postgresql"
DATABASE_URL="file:./dev.db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication secret for sessions
NEXTAUTH_SECRET="hive-session-secret-key-32chars-min-hackathon"
NEXTAUTH_URL="http://localhost:3000"

# Demo Mode toggle (seeds realistic Pune kirana stores & Indian grocery catalog)
DEMO_MODE="true"

# External Integrations (Optional - falls back to realistic simulation if disabled)
NEXT_PUBLIC_MAPS_API_KEY=""
NEXT_PUBLIC_MAPS_ENABLED="false"
